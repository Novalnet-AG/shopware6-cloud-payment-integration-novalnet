{% sw_extends '@Storefront/storefront/page/checkout/finish/finish-details.html.twig' %}


{% block page_checkout_finish_order %}
	{{ parent() }}
    {% set orderTransaction = page.order.transactions.last %}
    {% set customFields = page.order.transactions.last.getCustomFields() %}
    {% set qrCodeImage = customFields['nnQrCode'] %}
    
    {% if 'novalnetpaymentapp' in orderTransaction.paymentMethod.handlerIdentifier %}
		<div class="row finish-info">
			<div class="col-md-12">
				<div class="row">
					<div class="card checkout-card">
						<div class="card-body">
							<div class="card-title">
								{{ "checkout.customerCommentHeader"|trans|sw_sanitize }}
							</div>
							<div class="col-sm-6 float-start">
								{{ page.order.customerComment|sw_sanitize|nl2br }}
							</div>
							{% if qrCodeImage is not empty %}
								<div class="col-sm-6 float-start text-center">
									<div class="qr-code-text">
										{{ "NovalnetPaymentApp.text.epcQrCodeDesc"|trans|sw_sanitize }}
									</div>
									<div class="qr-code-image">
										<img src="{{ qrCodeImage }}" alt="QR Code" title="QR Code" />
									</div>
								</div>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>
	{% endif %}
{% endblock %}
