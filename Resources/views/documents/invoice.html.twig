{% sw_extends '@Framework/documents/invoice.html.twig' %}

{% block document_payment_shipping_inner %}
    {{ parent() }}
    {% if order.customerComment != '' %}
		<br><strong>{{ "checkout.customerCommentHeader"|trans|sw_sanitize }}</strong><br>
		{{ order.customerComment | nl2br }}
	{% endif %}

	{% set orderTransaction = order.transactions.last %}
    {% set customFields = order.transactions.last.getCustomFields() %}
    {% set qrCodeImage = customFields['nnQrCode'] %}

    {% if 'novalnetpaymentapp' in orderTransaction.paymentMethod.handlerIdentifier and qrCodeImage is not empty %}
        <div class="col-12 card-content mt-2">
            <div class="qr-code-text">
                {{ "NovalnetPaymentApp.text.epcQrCodeDesc"|trans|sw_sanitize }}
            </div>
            <div class="qr-code-image">
                <img src="{{ qrCodeImage }}" alt="QR Code" title="QR Code" />
            </div>
        </div>
    {% endif %}
{% endblock %}
